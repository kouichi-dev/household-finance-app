# ===== データベース =====
# アプリ本体（database.py）と Alembic（alembic/env.py）の両方が読む
# ホスト名 db は docker-compose のサービス名
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/household_finance

# pytest 用。db/init.sql が作成する household_test を指す
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/household_test

# ===== dbコンテナの初期化 =====
# この2つはデータボリュームが空のときにのみ使われる
POSTGRES_DB=household_finance
POSTGRES_PASSWORD=CHANGE_ME

# ===== 認証 =====
# JWTの署名鍵。openssl rand -hex 32 で生成する
SECRET_KEY=CHANGE_ME
